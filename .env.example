# --- Aplicación ---
APP_ENV=production            # production | local
APP_DEBUG=0                   # 1 muestra errores en pantalla (solo local)
APP_URL=https://www.ejemplo.com.ar   # URL pública sin barra final (canonical, sitemap, OG)
APP_NOMBRE="Alquileres Río Gallegos"
APP_EMAIL_CONTACTO=contacto@ejemplo.com.ar
# Clave secreta para firmar tokens. Generar con: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# --- Base de datos (MySQL 8 / MariaDB 10.6+) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=alquileres
DB_USER=alquileres
DB_PASS=

# --- Email (Brevo) ---
MAIL_DRIVER=log                 # brevo en producción; log escribe en storage/logs/mail.log
BREVO_API_KEY=
MAIL_FROM=avisos@ejemplo.com.ar # remitente verificado en Brevo
MAIL_FROM_NOMBRE="Alquileres Río Gallegos"
MODERACION_EMAIL=               # recibe avisos nuevos para moderar y denuncias (vacío = no avisar)

# --- Formulario público ---
PUBLICAR_MAX_POR_DIA=5          # envíos por IP cada 24 h
CONFIRMACION_HORAS=72           # plazo para confirmar el email; después el aviso se borra

# --- Fotos ---
FOTOS_MAX_POR_AVISO=12
FOTOS_MAX_MB=8

# --- Mapa (Leaflet + tiles OSM; se puede cambiar de proveedor sin tocar código) ---
MAPA_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAPA_ATRIBUCION="&copy; OpenStreetMap"
MAPA_CENTRO_LAT=-51.6230
MAPA_CENTRO_LNG=-69.2168

# --- Frescura de avisos ---
FRESCURA_DIAS_VERIFICACION=15   # días sin verificar para entrar en la cola
FRESCURA_DIAS_GRACIA=7          # días para responder el "¿sigue disponible?"
FRESCURA_AUTODESPUBLICAR=0      # 1 = el cron pausa los que no respondieron
NOTIFICADOR=null                # null (manual) | email (usa Brevo) | whatsapp (stub)
