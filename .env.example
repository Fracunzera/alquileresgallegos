# --- Aplicación ---
APP_ENV=production            # production | local
APP_DEBUG=0                   # 1 muestra errores en pantalla (solo local)
APP_URL=https://www.ejemplo.com.ar   # URL pública sin barra final (canonical, sitemap, OG)
APP_INDEXAR=1                 # 0 en el sitio de prueba: noindex en todo, sin sitemap y aviso de "versión de prueba"
APP_NOMBRE="Alquileres Río Gallegos"
APP_EMAIL_CONTACTO=contacto@ejemplo.com.ar
# Clave secreta para firmar tokens. Generar con: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# --- Proxy (Cloudflare, balanceador del hosting). Vacío si el servidor recibe las conexiones directo ---
# IPs o rangos CIDR del proxy, separados por coma. Con Cloudflare: sus rangos (cloudflare.com/ips) e IP_CABECERA=CF-Connecting-IP
PROXIES_CONFIABLES=
IP_CABECERA=X-Forwarded-For

# --- Base de datos (MySQL 8.4 LTS / MariaDB 10.11+) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=alquileres
DB_USER=alquileres
DB_PASS=

# --- Email (Brevo) ---
MAIL_DRIVER=log                 # brevo en producción; log escribe en storage/logs/mail.log
BREVO_API_KEY=
MAIL_FROM=avisos@ejemplo.com.ar # remitente verificado en Brevo
MAIL_FROM_NOMBRE="Alquileres Río Gallegos"
MODERACION_EMAIL=               # recibe avisos nuevos para moderar y denuncias (vacío = no avisar)

# --- Captcha opcional (Cloudflare Turnstile). Vacío = apagado ---
# Se usa en /publicar, /cuenta/registro y /aviso/{id}/denunciar. Claves en dash.cloudflare.com → Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Formulario público ---
PUBLICAR_MAX_POR_DIA=5          # envíos por IP cada 24 h
BLOQUEO_IP_DIAS=7               # los bloqueos por IP vencen (en celulares muchos comparten IP)
CONFIRMACION_HORAS=72
CUENTA_MAX_AVISOS_PARTICULAR=3  # avisos vigentes por cuenta de particular
CUENTA_LINK_MINUTOS=60          # vigencia del link de ingreso por email
DENUNCIAS_PARA_PAUSAR=3         # denuncias desde IP distintas que pausan un aviso ("usan mi número" pausa con 1)           # plazo para confirmar el email; después el aviso se borra

# --- Fotos ---
FOTOS_MAX_POR_AVISO=12
FOTOS_MAX_MB=8

# --- Mapa (Leaflet + tiles OSM; se puede cambiar de proveedor sin tocar código) ---
MAPA_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAPA_ATRIBUCION="&copy; OpenStreetMap"
MAPA_CENTRO_LAT=-51.6230
MAPA_CENTRO_LNG=-69.2168

# --- Frescura de avisos ---
FRESCURA_DIAS_VERIFICACION=15   # días sin verificar para entrar en la cola
FRESCURA_DIAS_GRACIA=7          # días para responder el "¿sigue disponible?"
FRESCURA_AUTODESPUBLICAR=0      # 1 = el cron pausa los que no respondieron
NOTIFICADOR=null                # null (manual) | email (usa Brevo) | whatsapp (stub)
